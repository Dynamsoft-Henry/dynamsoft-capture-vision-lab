  ],
  "DocumentNormalizerTaskSettingOptions": [
    {
      "Name": "task-detect-and-normalize-document",
      "MaxThreadsInOneTask": 1,
      "SectionArray": [
        {
          "Section": "ST_DOCUMENT_DETECTION",
